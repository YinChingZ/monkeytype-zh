{
  "manifest_version": 3,
  "name": "Monkeytype 中文释义",
  "version": "1.1.0",
  "description": "跟随 Monkeytype 当前英文单词显示离线中文释义。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://monkeytype.com/*",
        "https://www.monkeytype.com/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Monkeytype 中文释义",
    "default_popup": "popup.html"
  }
}
